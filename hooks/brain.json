{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{SKILL_DIR}}/scripts/session_start.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"{{SKILL_DIR}}/scripts/session_end.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
